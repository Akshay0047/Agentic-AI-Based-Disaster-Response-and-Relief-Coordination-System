# ==============================================================================
# Disaster Response System - Environment Configuration
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit the real `.env` file.
# ==============================================================================

# --- Application ---
APP_NAME=Disaster Response System
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security / JWT ---
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- PostgreSQL ---
POSTGRES_USER=drs
POSTGRES_PASSWORD=drs_password
POSTGRES_DB=disaster_response
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Async SQLAlchemy URL (used by the FastAPI app) ---
DATABASE_URL=postgresql+asyncpg://drs:drs_password@localhost:5432/disaster_response

# --- Sync SQLAlchemy URL (used by Alembic migrations) ---
DATABASE_URL_SYNC=postgresql+psycopg2://drs:drs_password@localhost:5432/disaster_response

# --- SQS (Phase 1: interface only, no AWS connection yet) ---
SQS_EMERGENCY_QUEUE=emergency-requests
SQS_REPLAN_QUEUE=replan-events
SQS_ENDPOINT_URL=
AWS_REGION=us-east-1
SQS_ENABLED=false